{
  "info": {
    "name": "Task App REST API",
    "_postman_id": "a9d82c40-7f12-4c9a-9e81-taskapp2026",
    "description": "Complete REST API collection for Task App (Authentication, User Profile, Avatar Management, Tasks with Tags/Details/DueDate, and Color-Coded Tags).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tagId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users & Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Botelho\",\n  \"email\": \"joao@example.com\",\n  \"password\": \"SecurePass123\",\n  \"age\": 26\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    pm.collectionVariables.set('userId', jsonData.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@example.com\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": "{{baseUrl}}/users/login"
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update Current Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Henrique Botelho\",\n  \"age\": 27\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/users/me/avatar"
          }
        },
        {
          "name": "Get My Avatar",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me/avatar"
          }
        },
        {
          "name": "Get User Avatar by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}/avatar"
          }
        },
        {
          "name": "Delete Avatar",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/me/avatar"
          }
        },
        {
          "name": "Logout Current Session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/logout"
          }
        },
        {
          "name": "Logout All Sessions",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/logoutAll"
          }
        },
        {
          "name": "Delete Current Account",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Create Tag",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('tagId', jsonData._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Backend\",\n  \"color\": \"magenta\"\n}"
            },
            "url": "{{baseUrl}}/tags"
          }
        },
        {
          "name": "List Tags (Search & Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tags?limit=50&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["tags"],
              "query": [
                { "key": "search", "value": "Back", "disabled": true },
                { "key": "limit", "value": "50" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Update Tag",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API & Backend\",\n  \"color\": \"teal\"\n}"
            },
            "url": "{{baseUrl}}/tags/{{tagId}}"
          }
        },
        {
          "name": "Delete Tag",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tags/{{tagId}}"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('taskId', jsonData._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Review Jest & Cypress coverage\",\n  \"details\": \"Ensure backend routers and Vue components have full test coverage.\",\n  \"dueDate\": \"2026-12-01T00:00:00.000Z\",\n  \"completed\": false,\n  \"tags\": [\n    \"{{tagId}}\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "List Tasks (Filtered, Sorted & Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?limit=10&skip=0&sortBy=createdAt:desc",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "completed", "value": "false", "disabled": true },
                { "key": "tag", "value": "{{tagId}}", "disabled": true },
                { "key": "limit", "value": "10" },
                { "key": "skip", "value": "0" },
                { "key": "sortBy", "value": "createdAt:desc" }
              ]
            }
          }
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Review Jest & Cypress coverage (Done)\",\n  \"details\": \"All unit, integration, component, and E2E suites passing.\",\n  \"dueDate\": \"2026-12-05T00:00:00.000Z\",\n  \"completed\": true,\n  \"tags\": [\n    \"{{tagId}}\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        }
      ]
    }
  ]
}