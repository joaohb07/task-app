{
  "name": "task-app",
  "version": "2.0.0",
  "description": "Full Stack Task Manager API with Node.js, Express, MongoDB and Vue + Carbon Design System.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/db/mongoose.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.0",
    "sharp": "^0.35.5",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
